# Required on first launch. Replace with a strong password for the initial System Admin.
ACCOUNTING_PASSWORD="replace-with-a-strong-admin-password"

# Username for the initial System Admin account (defaults to admin).
ADMIN_USERNAME=admin

# Required. Generate a unique random value of at least 32 characters.
SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional. Persistent SQLite directory; use a persistent disk when deploying.
DATA_DIR=./data
PORT=3000
NODE_ENV=development

# Optional. Supabase PostgreSQL connection string. When set, the app uses Supabase
# instead of local SQLite. Keep this server-side secret private; use the direct or
# session-pooler URI from Supabase Dashboard > Project Settings > Database.
SUPABASE_DB_URL=
