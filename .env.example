# Required on first launch. Replace with a strong password for the initial System Admin.
ACCOUNTING_PASSWORD="replace-with-a-strong-admin-password"

# Username for the initial System Admin account (defaults to admin).
ADMIN_USERNAME=admin

# Required. Generate a unique random value of at least 32 characters.
SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional. Persistent SQLite directory; use a persistent disk when deploying.
DATA_DIR=./data
PORT=3000
NODE_ENV=development

# Optional. Supabase PostgreSQL connection string. Use SUPABASE_DB_URL or DATABASE_URL.
# When set, the app uses Supabase instead of local SQLite.
# Keep this server-side secret private; use the session-pooler URI from Supabase
# Dashboard > Project Settings > Database > Connect.
SUPABASE_DB_URL=

# Optional organizational OneDrive integration (secrets stay on the server)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_AUTHORITY=organizations
# Production origin, e.g. https://your-app.example.com (optional locally)
APP_URL=http://localhost:3000
